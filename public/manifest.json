{
  "manifest_version": 3,
  "name": "PegBoard",
  "version": "1.0.0",
  "description": "Personal new tab launcher with sections, badges, and search",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage", "favicon", "contextMenus"],
  "omnibox": { "keyword": "pb" },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
